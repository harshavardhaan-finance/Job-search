# Copy this file to ".env" and fill in real values.
# ".env" is in .gitignore, so your secrets never get committed.
# Fill in a value only when you reach the phase that uses it.

# Where the SQLite database lives (default is fine)
DB_PATH=data/jobs.db

# Optional: an email address put in the app's User-Agent, so a site owner
# can contact you instead of blocking you. Leave blank if you prefer.
CONTACT_EMAIL=

# Phase 2: Adzuna API (free key from https://developer.adzuna.com/)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Phase 3: Gmail job-alert reader (use a Gmail *app password*, not your real password)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_LABEL=job-alerts

# Phase 4: Claude API for scoring
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
